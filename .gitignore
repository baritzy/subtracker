# NEVER commit signing material. This repo is PUBLIC.
# Leaking release-keystore.jks plus the password in app/build.gradle.kts
# would let anyone sign builds that Play accepts as authentic updates.
*.jks
*.keystore
*.p12
*.pem
local.properties
google-services.json

# 50 single-use promo codes for the paid product. Publishing these would
# let anyone redeem premium for free.
promotion_codes.csv
promo-codes-tracker.md

# App source IS now tracked (2026-08-09). The keystore password was moved out
# of app/build.gradle.kts into keystore.properties, which subtracker-kotlin/
# .gitignore excludes along with *.jks, local.properties and
# google-services.json. Verified the release build still signs with the same
# upload key (SHA-1 24:14:62) after the change.

server/data/
*.db
